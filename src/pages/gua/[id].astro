---
import Base from '../../layouts/Base.astro';
import GuaSymbol from '../../components/GuaSymbol.astro';
import { HEXAGRAMS, getHexagram, getTrigram, yaoTitle } from '../../lib/iching';
import { getText } from '../../data/hexagram-text';

export function getStaticPaths() {
  return HEXAGRAMS.map((h) => ({ params: { id: String(h.id) } }));
}

const id = Number(Astro.params.id);
const hex = getHexagram(id);
const upper = getTrigram(hex.upper);
const lower = getTrigram(hex.lower);
const text = getText(id);

const opposite = getHexagram(hex.opposite);
const reverse = getHexagram(hex.reverse);
const nuclear = getHexagram(hex.nuclear);

const relations = [
  { key: '错卦', sub: '旁通 · 六爻全变', hex: opposite },
  { key: '综卦', sub: '反对 · 整卦颠倒', hex: reverse },
  { key: '互卦', sub: '二三四 / 三四五爻', hex: nuclear },
];

const prev = id > 1 ? getHexagram(id - 1) : null;
const next = id < 64 ? getHexagram(id + 1) : null;
---

<Base title={`${hex.fullName}`} description={`第${id}卦 ${hex.fullName}`}>
  <article>
    <header class="gua-head">
      <div class="gua-head-symbol">
        <GuaSymbol lines={hex.lines} size={120} />
      </div>
      <div class="gua-head-meta">
        <div class="gua-no">第 {id} 卦</div>
        <h1>{hex.name}{hex.alias ? `（${hex.alias}）` : ''}</h1>
        <div class="gua-full">{hex.fullName}</div>
        <div class="meta-row" style="margin-top:0.6rem">
          <span class="pill">上卦 {upper.symbol} {upper.name}（{upper.nature}·{upper.attribute}）</span>
          <span class="pill">下卦 {lower.symbol} {lower.name}（{lower.nature}·{lower.attribute}）</span>
        </div>
      </div>
    </header>

    {
      text ? (
        <>
          <section>
            <div class="scripture">
              <span class="label">卦辞</span>
              <p>{text.guaci}</p>
            </div>
            <div class="scripture">
              <span class="label">彖传</span>
              <p>{text.tuan}</p>
            </div>
            <div class="scripture">
              <span class="label">大象传</span>
              <p>{text.daxiang}</p>
            </div>
          </section>

          <section>
            <h2>六爻</h2>
            <div class="yao-list">
              {text.yao.map((y, i) => (
                <div class="yao-item">
                  <div class="yao-glyph">
                    <GuaSymbol lines={hex.lines} size={54} highlight={i} />
                  </div>
                  <div class="yao-body">
                    <div class="yao-title">{yaoTitle(i, hex.lines[i])}</div>
                    <p class="yao-text">{y.text}</p>
                    <p class="xiang">{y.xiang}</p>
                  </div>
                </div>
              ))}
            </div>
            {text.extra && text.extra.length > 0 && (
              <div class="yao-extra">
                {text.extra.map((e) => (
                  <div class="scripture">
                    <span class="label">{e.name}</span>
                    <p>{e.text}</p>
                    {e.xiang && <p class="xiang">{e.xiang}</p>}
                  </div>
                ))}
              </div>
            )}
          </section>

          <section>
            <div class="insight">
              <div class="label">系统思维 · 导读</div>
              <p>{text.guide}</p>
            </div>
          </section>
        </>
      ) : (
        <section>
          <div class="todo-note">
            <p><strong>本卦经文（卦辞 · 彖 · 大象 · 爻辞）待校订录入。</strong></p>
            <p class="muted">
              为保证经典准确，经文将依可靠底本逐卦校订后录入，暂不臆造。
              下方卦象结构与卦变关系由程序推导，准确可用。
            </p>
          </div>
        </section>
      )
    }

    <section>
      <h2>卦变关系</h2>
      <div class="rel-grid">
        {
          relations.map((r) => (
            <a class="rel-card" href={`/gua/${r.hex.id}`}>
              <div class="rel-key">{r.key}</div>
              <div class="rel-sub">{r.sub}</div>
              <GuaSymbol lines={r.hex.lines} size={44} />
              <div class="rel-name">
                第 {r.hex.id} 卦 · {r.hex.name}
              </div>
            </a>
          ))
        }
      </div>
      <p class="muted" style="margin-top:0.8rem">
        错卦见其「对立面」，综卦见其「换位之象」，互卦见其「内在所含」——三种卦变，是观察一个系统的三个视角。
      </p>
    </section>

    <nav class="gua-nav">
      {prev ? <a href={`/gua/${prev.id}`}>← 第 {prev.id} 卦 {prev.name}</a> : <span></span>}
      <a href="/gua">返回六十四卦</a>
      {next ? <a href={`/gua/${next.id}`}>第 {next.id} 卦 {next.name} →</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .gua-head {
    display: flex;
    gap: 1.6rem;
    align-items: center;
    flex-wrap: wrap;
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .gua-no {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .gua-head h1 {
    font-size: 2.4rem;
    margin: 0.2rem 0;
  }
  .gua-full {
    color: var(--accent);
    font-size: 1.1rem;
  }
  .yao-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .yao-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 0.7rem 0.9rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .yao-glyph {
    flex: 0 0 auto;
    padding-top: 0.2rem;
  }
  .yao-title {
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }
  .yao-text {
    margin: 0.1rem 0;
  }
  .yao-extra {
    margin-top: 0.8rem;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }
  .rel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
  }
  .rel-card:hover {
    box-shadow: var(--shadow);
    text-decoration: none;
    transform: translateY(-2px);
    transition: all 0.12s ease;
  }
  .rel-key {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .rel-sub {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .rel-name {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .gua-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
</style>
