{
  "name": "classic-system",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive I Ching / Yijing systems-thinking atlas for Chinese classics, hexagrams, and digital humanities.",
  "license": "MIT",
  "homepage": "https://davirain-su.github.io/classic_system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaviRain-Su/classic_system.git"
  },
  "keywords": [
    "i-ching",
    "yijing",
    "zhouyi",
    "book-of-changes",
    "chinese-classics",
    "chinese-philosophy",
    "daoism",
    "confucianism",
    "buddhism",
    "digital-humanities",
    "knowledge-graph",
    "systems-thinking",
    "hexagrams",
    "astro",
    "react",
    "typescript"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "PUBLIC_SITE_URL=https://yijing.davirain.xyz/ astro build",
    "deploy:cloudflare": "pnpm build:cloudflare && npx wrangler pages deploy dist --project-name classic-system --branch main",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node --experimental-strip-types scripts/verify.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.2.0",
    "astro": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "opencc-js": "^1.3.1",
    "typescript": "^5.7.0"
  }
}
